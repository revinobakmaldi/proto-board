  "tour": [
    {
      "order": 1,
      "title": "FastAPI backend entry point",
      "description": "backend/app/main.py creates the FastAPI app, adds CORS middleware, and mounts the router at /api. Every request flows through routes.py which defines all endpoints.",
      "nodeIds": [
        "file:backend/app/main.py",
        "file:backend/app/routes.py"
      ]
    },
    {
      "order": 2,
      "title": "JWT authentication system",
      "description": "auth.py provides bcrypt password hashing, JWT token creation/verification via python-jose, and the get_current_user FastAPI dependency that protects all /layouts and /auth/me endpoints.",
      "nodeIds": [
        "file:backend/app/auth.py",
        "func:backend/app/auth.py:get_current_user",
        "func:backend/app/auth.py:create_access_token"
      ]
    },
    {
      "order": 3,
      "title": "Data models",
      "description": "database.py defines User and Layout SQLAlchemy models. User has a one-to-many relationship to Layout via user_id FK. schemas.py provides Pydantic validation for all request/response bodies.",
      "nodeIds": [
        "class:backend/app/database.py:User",
        "class:backend/app/database.py:Layout",
        "file:backend/app/schemas.py"
      ]
    },
    {
      "order": 4,
      "title": "Layout CRUD endpoints",
      "description": "routes.py implements full layout lifecycle: POST /api/auth/register, POST /api/auth/token, GET /api/auth/me, and GET/POST/PUT/DELETE /api/layouts. All mutations commit immediately to SQLite.",
      "nodeIds": [
        "func:backend/app/routes.py:register",
        "func:backend/app/routes.py:login",
        "func:backend/app/routes.py:list_layouts",
        "func:backend/app/routes.py:create_layout",
        "func:backend/app/routes.py:update_layout",
        "func:backend/app/routes.py:delete_layout"
      ]
    },
    {
      "order": 5,
      "title": "React frontend entry point",
      "description": "main.jsx mounts the React 18 app. App.jsx is the root component — manages auth state (JWT in localStorage), current layout, and conditionally renders Auth, Layouts, or the drag-drop editor.",
      "nodeIds": [
        "file:frontend/src/main.jsx",
        "file:frontend/src/App.jsx"
      ]
    },
    {
      "order": 6,
      "title": "Design system",
      "description": "theme.js exports the Nabati-inspired color palette (primary brown #4E342E, accent gold #d4af37) and DATA_COLORS array. All React components import from here for visual consistency.",
      "nodeIds": [
        "file:frontend/src/theme.js"
      ]
    },
    {
      "order": 7,
      "title": "Drag-and-drop canvas",
      "description": "Canvas.jsx is the core editor — renders positioned component instances with 8px grid snapping. Handles mouse drag/move/resize interactions. Components are rendered via componentRegistry renderComponent function.",
      "nodeIds": [
        "file:frontend/src/components/Canvas.jsx",
        "file:frontend/src/components/componentRegistry.jsx"
      ]
    },
    {
      "order": 8,
      "title": "Dashboard component library",
      "description": "componentRegistry.jsx defines 5 component types: KPICard, BarChartComponent, LineChartComponent, PieChartComponent, DataTable. Each has a data generator and Recharts-powered render function with Nabati-themed styling.",
      "nodeIds": [
        "file:frontend/src/components/componentRegistry.jsx"
      ]
    },
    {
      "order": 9,
      "title": "Production server architecture",
